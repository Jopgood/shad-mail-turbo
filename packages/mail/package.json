    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "devDependencies": {
    "@shad-mail/eslint-config": "workspace:*",
    "@shad-mail/prettier-config": "workspace:*",
    "@shad-mail/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@shad-mail/prettier-config",
  "dependencies": {
    "zustand": "^5.0.8"
  }
}
