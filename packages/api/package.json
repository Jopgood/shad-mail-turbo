{
  "name": "@shad-mail/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@shad-mail/auth": "workspace:*",
    "@shad-mail/db": "workspace:*",
    "@shad-mail/mail": "workspace:*",
    "@shad-mail/validators": "workspace:*",
    "@trpc/server": "catalog:",
    "google-auth-library": "^10.3.0",
    "googleapis": "^160.0.0",
    "superjson": "2.2.2"
  },
  "devDependencies": {
    "@shad-mail/eslint-config": "workspace:*",
    "@shad-mail/prettier-config": "workspace:*",
    "@shad-mail/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@shad-mail/prettier-config"
}
